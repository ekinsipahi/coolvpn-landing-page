# VPNsterr ortam değişkenleri — gerçek değerleri .env dosyasına koy (.env commit edilmez)

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Site
SITE_URL=http://127.0.0.1:8000

# Veritabanı (Postgres)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NOWPayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Domain taşıma (301)
CANONICAL_HOST=vpnsterr.com
OLD_HOSTS=coolvpn.app,www.coolvpn.app,www.vpnsterr.com

# Eklenti/havuz paylaşılan sırrı (pool ile aynı)
EXTENSION_SHARED_SECRET=
EXTENSION_TOKEN_TTL_SECONDS=3600

# E-posta (şifre sıfırlama)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=VPNsterr <support@vpnsterr.com>

# Google Analytics 4
GA_MEASUREMENT_ID=

# HTTP cron tetikleyici (cron-job.org) anahtarı
CRON_SECRET=

# --- Resend (işlem + pazarlama mailleri; boşsa console'a düşer) ---
RESEND_API_KEY=
NOREPLY_EMAIL=VPNsterr <noreply@vpnsterr.com>
# Ticket / asistan escalation bildirimlerinin gittiği operatör adresi
SUPPORT_FORWARD_EMAIL=

# --- AI asistan (köşedeki chatbox) ---
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-4-5-20251001
